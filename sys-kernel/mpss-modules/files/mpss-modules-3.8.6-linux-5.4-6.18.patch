diff --git a/include/mic/mic_compat.h b/include/mic/mic_compat.h
new file mode 100644
index 0000000..e7a2b9f
--- /dev/null
+++ b/include/mic/mic_compat.h
@@ -0,0 +1,162 @@
+#ifndef MIC_COMPAT_H
+#define MIC_COMPAT_H
+
+#include <linux/version.h>
+
+/* Kernel API shims so the MPSS host driver builds across 4.x - 5.10. */
+
+/* mm->mmap_sem was renamed mmap_lock with helpers (linux/mmap_lock.h) in 5.8;
+   some 5.4.y stable kernels backport it, so guard on the header, not the version. */
+#include <linux/mm.h>   /* pulls linux/mmap_lock.h where present */
+#ifndef _LINUX_MMAP_LOCK_H
+static inline void mmap_read_lock(struct mm_struct *mm)     { down_read(&mm->mmap_sem); }
+static inline void mmap_read_unlock(struct mm_struct *mm)   { up_read(&mm->mmap_sem); }
+static inline void mmap_write_lock(struct mm_struct *mm)    { down_write(&mm->mmap_sem); }
+static inline void mmap_write_unlock(struct mm_struct *mm)  { up_write(&mm->mmap_sem); }
+static inline int  mmap_write_trylock(struct mm_struct *mm) { return down_write_trylock(&mm->mmap_sem); }
+#endif
+
+/* ioremap_nocache was folded into ioremap (non-cached by default) in 5.6. */
+#if LINUX_VERSION_CODE >= KERNEL_VERSION(5, 6, 0)
+#define ioremap_nocache ioremap
+#endif
+
+/* proc_create*() take struct proc_ops (not file_operations) since 5.6. */
+#if LINUX_VERSION_CODE >= KERNEL_VERSION(5, 6, 0)
+#define MIC_SEQ_PROC_OPS(name, openfn) \
+	static const struct proc_ops name = { \
+		.proc_open = openfn, .proc_read = seq_read, \
+		.proc_lseek = seq_lseek, .proc_release = single_release }
+#define MIC_READ_PROC_OPS(name, readfn) \
+	static const struct proc_ops name = { .proc_read = readfn }
+#else
+#define MIC_SEQ_PROC_OPS(name, openfn) \
+	static const struct file_operations name = { \
+		.owner = THIS_MODULE, .open = openfn, .read = seq_read, \
+		.llseek = seq_lseek, .release = single_release }
+#define MIC_READ_PROC_OPS(name, readfn) \
+	static const struct file_operations name = { .read = readfn }
+#endif
+
+/* {smp_,}read_barrier_depends() removed in 5.9 (no-ops off old Alpha). */
+#if LINUX_VERSION_CODE >= KERNEL_VERSION(5, 9, 0)
+#ifndef read_barrier_depends
+#define read_barrier_depends() do {} while (0)
+#endif
+#ifndef smp_read_barrier_depends
+#define smp_read_barrier_depends() do {} while (0)
+#endif
+#endif
+
+/* tty write_room() returns unsigned int since 5.15. */
+#if LINUX_VERSION_CODE >= KERNEL_VERSION(5, 15, 0)
+#define MIC_TTY_WRITE_ROOM_RET unsigned int
+#else
+#define MIC_TTY_WRITE_ROOM_RET int
+#endif
+
+/* PDE_DATA() was renamed pde_data() in 5.17. */
+#if LINUX_VERSION_CODE >= KERNEL_VERSION(5, 17, 0)
+#define PDE_DATA(inode) pde_data(inode)
+#endif
+
+/* Legacy pci_* DMA wrappers were removed in 5.18; map to the dma_* API
+   (which takes a struct device * and DMA_* direction constants). */
+#if LINUX_VERSION_CODE >= KERNEL_VERSION(5, 18, 0)
+#define PCI_DMA_BIDIRECTIONAL DMA_BIDIRECTIONAL
+#define PCI_DMA_TODEVICE      DMA_TO_DEVICE
+#define PCI_DMA_FROMDEVICE    DMA_FROM_DEVICE
+#define PCI_DMA_NONE          DMA_NONE
+#define pci_map_single(p, a, s, d)              dma_map_single(&(p)->dev, a, s, d)
+#define pci_unmap_single(p, a, s, d)            dma_unmap_single(&(p)->dev, a, s, d)
+#define pci_dma_mapping_error(p, a)             dma_mapping_error(&(p)->dev, a)
+#define pci_dma_sync_single_for_cpu(p, a, s, d) dma_sync_single_for_cpu(&(p)->dev, a, s, d)
+#define pci_set_dma_mask(p, m)                  dma_set_mask(&(p)->dev, m)
+#define pci_set_consistent_dma_mask(p, m)       dma_set_coherent_mask(&(p)->dev, m)
+#define pci_map_page(p, pg, o, s, d)            dma_map_page(&(p)->dev, pg, o, s, d)
+#define pci_unmap_page(p, a, s, d)              dma_unmap_page(&(p)->dev, a, s, d)
+#define pci_map_sg(p, sg, n, d)                 dma_map_sg(&(p)->dev, sg, n, d)
+#define pci_unmap_sg(p, sg, n, d)               dma_unmap_sg(&(p)->dev, sg, n, d)
+#endif
+
+/* tty set_termios() old-termios argument became const in 6.1. */
+#if LINUX_VERSION_CODE >= KERNEL_VERSION(6, 1, 0)
+#define MIC_TTY_TERMIOS_CONST const
+#else
+#define MIC_TTY_TERMIOS_CONST
+#endif
+
+/* struct class.devnode() takes a const struct device * since 6.2. */
+#if LINUX_VERSION_CODE >= KERNEL_VERSION(6, 2, 0)
+#define MIC_DEVNODE_CONST const
+#else
+#define MIC_DEVNODE_CONST
+#endif
+
+/* tty write() returns ssize_t and takes size_t count since 6.6. */
+#if LINUX_VERSION_CODE >= KERNEL_VERSION(6, 6, 0)
+#define MIC_TTY_WRITE_RET   ssize_t
+#define MIC_TTY_WRITE_COUNT size_t
+#else
+#define MIC_TTY_WRITE_RET   int
+#define MIC_TTY_WRITE_COUNT int
+#endif
+
+/* mmap_write_trylock() wrapper was removed from the kernel after 6.1; go
+   straight to the underlying lock (mmap_lock rwsem, or pre-5.8 mmap_sem). */
+#if !defined(_LINUX_MMAP_LOCK_H)
+#define mic_mmap_write_trylock(mm) down_write_trylock(&(mm)->mmap_sem)
+#elif LINUX_VERSION_CODE < KERNEL_VERSION(5, 8, 0)
+/* 5.4.y backported the mmap_lock API but the field is still mmap_sem */
+#define mic_mmap_write_trylock(mm) mmap_write_trylock(mm)
+#else
+#define mic_mmap_write_trylock(mm) down_write_trylock(&(mm)->mmap_lock)
+#endif
+
+/* vma->vm_flags became read-only in 6.3; use the vm_flags_set() helper. */
+#if LINUX_VERSION_CODE >= KERNEL_VERSION(6, 3, 0)
+#define mic_vm_flags_set(vma, flags) vm_flags_set(vma, flags)
+#else
+#define mic_vm_flags_set(vma, flags) ((vma)->vm_flags |= (flags))
+#endif
+
+/* MAX_ORDER was made inclusive and renamed MAX_PAGE_ORDER in 6.8;
+   restore the old (exclusive) MAX_ORDER value so existing size math holds. */
+#if LINUX_VERSION_CODE >= KERNEL_VERSION(6, 8, 0)
+#define MAX_ORDER (MAX_PAGE_ORDER + 1)
+#endif
+
+/* eventfd_signal() dropped its (always-1) count argument in 6.8. */
+#if LINUX_VERSION_CODE >= KERNEL_VERSION(6, 8, 0)
+#define mic_eventfd_signal(ctx) eventfd_signal(ctx)
+#else
+#define mic_eventfd_signal(ctx) eventfd_signal(ctx, 1)
+#endif
+
+/* block_device->bd_inode was removed in 6.11; bdev_nr_bytes() (since 5.16)
+   is the portable way to get a block device size. */
+#if LINUX_VERSION_CODE >= KERNEL_VERSION(5, 16, 0)
+#define MIC_BDEV_NR_SECTORS(bdev) (bdev_nr_bytes(bdev) / SECTOR_SIZE)
+#else
+#define MIC_BDEV_NR_SECTORS(bdev) (i_size_read((bdev)->bd_inode) / SECTOR_SIZE)
+#endif
+
+/* sysfs bin_attribute read/write callbacks take const bin_attribute * since 6.17. */
+#if LINUX_VERSION_CODE >= KERNEL_VERSION(6, 17, 0)
+#define MIC_BIN_ATTR_CONST const
+#else
+#define MIC_BIN_ATTR_CONST
+#endif
+
+/* del_timer_sync() was removed after 6.15; timer_delete_sync() exists since 6.2. */
+#if LINUX_VERSION_CODE >= KERNEL_VERSION(6, 2, 0)
+#define mic_del_timer_sync(t) timer_delete_sync(t)
+#else
+#define mic_del_timer_sync(t) del_timer_sync(t)
+#endif
+
+/* from_timer() was renamed timer_container_of() in 6.16; both are just
+   container_of() on the embedded timer_list, so define it directly. */
+#define mic_from_timer(var, cb, field) container_of(cb, typeof(*(var)), field)
+
+#endif /* MIC_COMPAT_H */
