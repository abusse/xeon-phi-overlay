index 000000000000..5a0c73126570
--- /dev/null
+++ b/drivers/sfi/sfi_acpi.c
@@ -0,0 +1,214 @@
+/* sfi_acpi.c Simple Firmware Interface - ACPI extensions */
+
+/*
+
