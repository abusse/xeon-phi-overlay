diff --git a/arch/x86/kernel/head_64.S b/arch/x86/kernel/head_64.S
index eda6353d2e0f..f3d79cbd9cc1 100644
--- a/arch/x86/kernel/head_64.S
+++ b/arch/x86/kernel/head_64.S
@@ -683,6 +683,21 @@ SYM_DATA_START_PTI_ALIGNED(init_top_pgt)
 	.fill	512,8,0
 	.fill	PTI_USER_PGD_FILL,8,0
 SYM_DATA_END(init_top_pgt)
+#ifdef CONFIG_MK1OM
+/*
+ * The non-Xen boot builds identity maps at runtime via early_dynamic_pgts and
+ * provides no static level3_ident_pgt. The KNC CC6/PC6 resume trampolines
+ * (C-step only) still expect one to seed their low-memory identity page tables,
+ * so provide the same static identity L3/L2 the Xen path uses (first 1G).
+ */
+SYM_DATA_START_PAGE_ALIGNED(level3_ident_pgt)
+	.quad	level2_ident_pgt - __START_KERNEL_map + _KERNPG_TABLE_NOENC
+	.fill	511, 8, 0
+SYM_DATA_END(level3_ident_pgt)
+SYM_DATA_START_PAGE_ALIGNED(level2_ident_pgt)
+	PMDS(0, __PAGE_KERNEL_IDENT_LARGE_EXEC, PTRS_PER_PMD)
+SYM_DATA_END(level2_ident_pgt)
+#endif
 #endif
 
 SYM_DATA_START_PAGE_ALIGNED(level4_kernel_pgt)
diff --git a/arch/x86/kernel/rtc.c b/arch/x86/kernel/rtc.c
index 51a849a79c98..1b4bb8b67ee2 100644
--- a/arch/x86/kernel/rtc.c
+++ b/arch/x86/kernel/rtc.c
@@ -107,7 +107,15 @@ int update_persistent_clock64(struct timespec64 now)
 /* not static: needed by APM */
 void read_persistent_clock64(struct timespec64 *ts)
 {
+#ifdef CONFIG_X86_EARLYMIC
+	/* No persistent (CMOS) RTC on the card; reading the absent CMOS
+	 * yields a garbage timespec that trips the strict sleep-delta check
+	 * in timekeeping_resume() on PC3 exit. Report no persistent clock. */
+	ts->tv_sec = 0;
+	ts->tv_nsec = 0;
+#else
 	x86_platform.get_wallclock(ts);
+#endif
 }
 
 
