diff --git a/arch/x86/include/asm/archrandom.h b/arch/x86/include/asm/archrandom.h
index 4c305305871b..0816ffdcd52a 100644
--- a/arch/x86/include/asm/archrandom.h
+++ b/arch/x86/include/asm/archrandom.h
@@ -17,13 +17,18 @@
 
 /* Unconditional execution of RDRAND and RDSEED */
 
+#ifdef CONFIG_X86_EARLYMIC
+/* no RDRAND/RDSEED on KNC (and no such mnemonics in the k1om assembler) */
+static inline bool __must_check rdrand_long(unsigned long *v) { return false; }
+static inline bool __must_check rdseed_long(unsigned long *v) { return false; }
+#else
 static inline bool __must_check rdrand_long(unsigned long *v)
 {
 	bool ok;
 	unsigned int retry = RDRAND_RETRY_LOOPS;
 	do {
-		asm volatile("rdrand %[out]"
-			     : "=@ccc" (ok), [out] "=r" (*v));
+		asm volatile("rdrand %[out]" CC_SET(c)
+			     : CC_OUT(c) (ok), [out] "=r" (*v));
 		if (ok)
 			return true;
 	} while (--retry);
@@ -33,11 +38,13 @@ static inline bool __must_check rdrand_long(unsigned long *v)
 static inline bool __must_check rdseed_long(unsigned long *v)
 {
 	bool ok;
-	asm volatile("rdseed %[out]"
-		     : "=@ccc" (ok), [out] "=r" (*v));
+	asm volatile("rdseed %[out]" CC_SET(c)
+		     : CC_OUT(c) (ok), [out] "=r" (*v));
 	return ok;
 }
 
+#endif
+
 /*
  * These are the generic interfaces; they must not be declared if the
  * stubs in <linux/random.h> are to be invoked.
diff --git a/arch/x86/include/asm/asm.h b/arch/x86/include/asm/asm.h
index d5c8d3afe196..5421c5aeedf9 100644
--- a/arch/x86/include/asm/asm.h
+++ b/arch/x86/include/asm/asm.h
@@ -113,6 +113,20 @@
 
 #endif
 
+/*
+ * Macros to generate condition code outputs from inline assembly. The output
+ * operand must be type "bool". The k1om gcc 5.1 accepts the "=@cc" flag-output
+ * constraint but miscompiles it (and does not define __GCC_ASM_FLAG_OUTPUTS__),
+ * so keep the setcc fallback that upstream dropped when it required gcc >= 8.
+ */
+#ifdef __GCC_ASM_FLAG_OUTPUTS__
+# define CC_SET(c) "\n\t/* output condition code " #c "*/\n"
+# define CC_OUT(c) "=@cc" #c
+#else
+# define CC_SET(c) "\n\tset" #c " %[_cc_" #c "]\n"
+# define CC_OUT(c) [_cc_ ## c] "=qm"
+#endif
+
 #ifndef __ASSEMBLER__
 static __always_inline __pure void *rip_rel_ptr(void *p)
 {
