 static inline bool memcmp_fs(const void *s1, addr_t s2, size_t len)
 {
 	bool diff;
-	asm volatile("fs repe cmpsb"
-		     : "=@ccnz" (diff), "+D" (s1), "+S" (s2), "+c" (len));
+	asm volatile("fs repe cmpsb" CC_SET(nz)
+		     : CC_OUT(nz) (diff), "+D" (s1), "+S" (s2), "+c" (len));
 	return diff;
 }
 static inline bool memcmp_gs(const void *s1, addr_t s2, size_t len)
 {
 	bool diff;
-	asm volatile("gs repe cmpsb"
-		     : "=@ccnz" (diff), "+D" (s1), "+S" (s2), "+c" (len));
+	asm volatile("gs repe cmpsb" CC_SET(nz)
+		     : CC_OUT(nz) (diff), "+D" (s1), "+S" (s2), "+c" (len));
 	return diff;
 }
 
diff --git a/arch/x86/boot/compressed/mem_encrypt.S b/arch/x86/boot/compressed/mem_encrypt.S
index 32f7cc8a8625..e36c679d5f52 100644
--- a/arch/x86/boot/compressed/mem_encrypt.S
+++ b/arch/x86/boot/compressed/mem_encrypt.S
@@ -68,7 +68,11 @@ SYM_CODE_START_LOCAL(sev_es_req_cpuid)
 	orl     $0x00000004, %eax
 	movl    $MSR_AMD64_SEV_ES_GHCB, %ecx
 	wrmsr
+#ifdef CONFIG_X86_EARLYMIC
+	.byte 0xf3, 0x0f, 0x01, 0xd9	# rep; vmmcall (no such mnemonic in the k1om assembler; SEV never runs here)
+#else
 	rep; vmmcall		# VMGEXIT
+#endif
 	rdmsr
 
 	/* Check response */
@@ -169,7 +173,11 @@ SYM_CODE_START_LOCAL(startup32_vc_handler)
 	xorl    %edx, %edx
 	movl    $MSR_AMD64_SEV_ES_GHCB, %ecx
 	wrmsr
+#ifdef CONFIG_X86_EARLYMIC
+	.byte 0xf3, 0x0f, 0x01, 0xd9	# rep; vmmcall (no such mnemonic in the k1om assembler; SEV never runs here)
+#else
 	rep; vmmcall
+#endif
 
 	/* If request fails, go to hlt loop */
 	hlt
diff --git a/arch/x86/boot/string.c b/arch/x86/boot/string.c
index b25c6a9303b7..a030f65c6e01 100644
--- a/arch/x86/boot/string.c
+++ b/arch/x86/boot/string.c
@@ -32,8 +32,13 @@
 int memcmp(const void *s1, const void *s2, size_t len)
 {
 	bool diff;
-	asm("repe cmpsb"
-	    : "=@ccnz" (diff), "+D" (s1), "+S" (s2), "+c" (len));
+#ifdef __GCC_ASM_FLAG_OUTPUTS__
+	asm("repe cmpsb" CC_SET(nz)
+	    : CC_OUT(nz) (diff), "+D" (s1), "+S" (s2), "+c" (len));
+#else	/* gcc < 6 (k1om toolchain) */
+	asm("repe cmpsb\n\tsetnz %0"
+	    : "=qm" (diff), "+D" (s1), "+S" (s2), "+c" (len) : : "cc");
+#endif
 	return diff;
 }
 
diff --git a/arch/x86/entry/calling.h b/arch/x86/entry/calling.h
index 77e2d920a640..3e9157b6b088 100644
--- a/arch/x86/entry/calling.h
+++ b/arch/x86/entry/calling.h
@@ -360,12 +360,20 @@ For 32-bit we have the following conventions - kernel is built with
  * to prevent the swapgs from getting speculatively skipped when coming from
  * user space.
  */
+#ifdef CONFIG_X86_EARLYMIC
+/* in-order core, no lfence in the assembler */
+.macro FENCE_SWAPGS_USER_ENTRY
+.endm
+.macro FENCE_SWAPGS_KERNEL_ENTRY
+.endm
+#else
 .macro FENCE_SWAPGS_USER_ENTRY
 	ALTERNATIVE "", "lfence", X86_FEATURE_FENCE_SWAPGS_USER
 .endm
 .macro FENCE_SWAPGS_KERNEL_ENTRY
 	ALTERNATIVE "", "lfence", X86_FEATURE_FENCE_SWAPGS_KERNEL
 .endm
+#endif
 
 .macro STACKLEAK_ERASE_NOCLOBBER
 #ifdef CONFIG_KSTACK_ERASE
@@ -375,6 +383,16 @@ For 32-bit we have the following conventions - kernel is built with
 #endif
 .endm
 
+#ifdef CONFIG_X86_EARLYMIC
+/* never executed on KNC (no FSGSBASE); the k1om assembler has no such mnemonics */
+.macro rdgsbase reg:req
+	ud2
+.endm
+.macro wrgsbase reg:req
+	ud2
+.endm
+#endif
+
 .macro SAVE_AND_SET_GSBASE scratch_reg:req save_reg:req
 	rdgsbase \save_reg
 	GET_PERCPU_BASE \scratch_reg
