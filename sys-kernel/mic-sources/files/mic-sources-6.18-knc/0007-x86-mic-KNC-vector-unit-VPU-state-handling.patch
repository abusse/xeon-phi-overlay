diff --git a/arch/x86/include/asm/fpu/types.h b/arch/x86/include/asm/fpu/types.h
index 93e99d2583d6..c34c3f7e60eb 100644
--- a/arch/x86/include/asm/fpu/types.h
+++ b/arch/x86/include/asm/fpu/types.h
@@ -149,6 +149,10 @@ enum xfeature {
 #define XFEATURE_MASK_APX		(1 << XFEATURE_APX)
 
 #define XFEATURE_MASK_FPSSE		(XFEATURE_MASK_FP | XFEATURE_MASK_SSE)
+#ifdef CONFIG_X86_EARLYMIC
+/* KNC: the VPU block takes the slot MPX uses elsewhere. */
+#define XFEATURE_MASK_ZMM		(1 << XFEATURE_BNDREGS)
+#endif
 #define XFEATURE_MASK_AVX512		(XFEATURE_MASK_OPMASK \
 					 | XFEATURE_MASK_ZMM_Hi256 \
 					 | XFEATURE_MASK_Hi16_ZMM)
@@ -336,6 +340,16 @@ struct xstate_header {
 	u64				reserved[6];
 } __attribute__((packed));
 
+#ifdef CONFIG_X86_EARLYMIC
+/* KNC VPU: 32 x 512-bit vector registers, 8 mask registers, VXCSR. */
+struct vpustate_struct {
+	u32				vector_space[512];
+	u16				k[8];
+	u32				vxcsr;
+	u32				reserved2[27];
+};
+#endif
+
 /*
  * xstate_header.xcomp_bv[63] indicates that the extended_state_area
  * is in compacted format.
@@ -354,6 +368,9 @@ struct xstate_header {
 struct xregs_state {
 	struct fxregs_state		i387;
 	struct xstate_header		header;
+#ifdef CONFIG_X86_EARLYMIC
+	struct vpustate_struct		vpu;
+#endif
 	u8				extended_state_area[];
 } __attribute__ ((packed, aligned (64)));
 
