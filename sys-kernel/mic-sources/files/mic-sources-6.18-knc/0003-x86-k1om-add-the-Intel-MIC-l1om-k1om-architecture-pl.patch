diff --git a/arch/x86/Kconfig b/arch/x86/Kconfig
index 127d0e7c1b12..93c26a46c605 100644
--- a/arch/x86/Kconfig
+++ b/arch/x86/Kconfig
@@ -339,6 +339,8 @@ config INSTRUCTION_DECODER
 config OUTPUT_FORMAT
 	string
 	default "elf32-i386" if X86_32
+	default "elf64-l1om" if "$(ARCH)" = "l1om"
+	default "elf64-k1om" if "$(ARCH)" = "k1om"
 	default "elf64-x86-64" if X86_64
 
 config LOCKDEP_SUPPORT
@@ -564,6 +566,7 @@ config X86_EXTENDED_PLATFORM
 
 	  64-bit platforms (CONFIG_64BIT=y):
 		Numascale NumaChip
+		Intel MIC PCIe coprocessor
 		ScaleMP vSMP
 		SGI Ultraviolet
 		Merrifield/Moorefield MID devices
@@ -587,6 +590,20 @@ config X86_NUMACHIP
 	  enable more than ~168 cores.
 	  If you don't have one of these, you should say N here.
 
+config X86_MICPCI
+	bool "Intel MIC PCIe coprocessor"
+	depends on X86_64
+	depends on X86_EXTENDED_PLATFORM
+	select ML1OM if "$(ARCH)" = "l1om"
+	select MK1OM if "$(ARCH)" = "k1om"
+	select VIRTIO			# mic_virtblk (out-of-tree) needs the virtio core
+	select VIRTIO_RING
+	select X86_LOCAL_APIC
+	select MMU_NOTIFIER
+	help
+	  Support for Intel Many Integrated Core (Intel MIC) SoC's in a
+	  PCIe coprocessor form factor.
+
 config X86_VSMP
 	bool "ScaleMP vSMP"
 	select HYPERVISOR_GUEST
@@ -2118,7 +2135,7 @@ config X86_NEED_RELOCS
 
 config PHYSICAL_ALIGN
 	hex "Alignment value to which kernel should be aligned"
-	default "0x200000"
+	default "0x1000000"
 	range 0x2000 0x1000000 if X86_32
 	range 0x200000 0x1000000 if X86_64
 	help
diff --git a/arch/x86/Kconfig.cpu b/arch/x86/Kconfig.cpu
index f928cf6e3252..cd2b83b6eed7 100644
--- a/arch/x86/Kconfig.cpu
+++ b/arch/x86/Kconfig.cpu
@@ -245,6 +245,38 @@ config MATOM
 
 endchoice
 
+# Intel MIC cores: outside the (32-bit only) processor family choice since 6.15
+config ML1OM
+	bool "Intel Aubrey Isle"
+	depends on X86_MICPCI && X86_64
+	help
+
+	  Select this for the CPU used in the Intel Many Integrated Core
+	  (Intel MIC) Software Development Vehicle code-named Knights
+	  Ferry. The CPU is an in-order, 4-way SMT design that is mostly
+	  x86-64 compatible but has a different vector unit. The
+	  differences from x86-64 (and Knights Corner) force
+	  incompatible calling conventions, so GCC and binutils assign
+	  it a unique ELF machine type: EM_L1OM.
+
+	  Future Intel products will be part of the x86 ecosystem, *not*
+	  derivatives of this incompatible offshoot.
+
+config MK1OM
+	bool "Intel Knights Corner"
+	depends on X86_MICPCI && X86_64
+	help
+
+	  Select this for the CPU used in the Intel Many Integrated Core
+	  (Intel MIC) products code-named Knights Corner. The CPU is an
+	  in-order, 4-way SMT design that is mostly x86-64 compatible
+	  but has a different vector unit. The differences from x86-64
+	  force incompatible calling conventions, so GCC and binutils
+	  assign it a unique ELF machine type: EM_K1OM.
+
+	  Future Intel products will be part of the x86 ecosystem, *not*
+	  derivatives of this incompatible offshoot.
+
 config CC_HAS_MARCH_NATIVE
 	# This flag might not be available in cross-compilers:
 	def_bool $(cc-option, -march=native)
@@ -291,7 +323,7 @@ config X86_INTERNODE_CACHE_SHIFT
 config X86_L1_CACHE_SHIFT
 	int
 	default "7" if MPENTIUM4
-	default "6" if MK7 || MPENTIUMM || MATOM || MVIAC7 || X86_GENERIC || X86_64
+	default "6" if MK7 || MPENTIUMM || MATOM || MVIAC7 || ML1OM || MK1OM || X86_GENERIC || X86_64
 	default "4" if MELAN || M486SX || M486 || MGEODEGX1
 	default "5" if MWINCHIP3D || MWINCHIPC6 || MCRUSOE || MEFFICEON || MCYRIXIII || MK6 || MPENTIUMIII || MPENTIUMII || M686 || M586MMX || M586TSC || M586 || MVIAC3_2 || MGEODE_LX
 
@@ -331,7 +363,7 @@ config X86_CX8
 # generates cmov.
 config X86_CMOV
 	def_bool y
-	depends on (MK7 || MPENTIUM4 || MPENTIUMM || MPENTIUMIII || MPENTIUMII || M686 || MVIAC3_2 || MVIAC7 || MCRUSOE || MEFFICEON || MATOM || MGEODE_LX || X86_64)
+	depends on (MK7 || MPENTIUM4 || MPENTIUMM || MPENTIUMIII || MPENTIUMII || M686 || MVIAC3_2 || MVIAC7 || MCRUSOE || MEFFICEON || MATOM || MGEODE_LX || X86_64) && !MK1OM	# no cmov on KNC
 
 config X86_MINIMUM_CPU_FAMILY
 	int
@@ -352,6 +384,11 @@ config X86_VMX_FEATURE_NAMES
 	def_bool y
 	depends on IA32_FEAT_CTL
 
+# not-X86_64 wierdness shared by ML1OM and MK1OM
+config X86_EARLYMIC
+       def_bool y
+       depends on ML1OM || MK1OM
+
 menuconfig PROCESSOR_SELECT
 	bool "Supported processor vendors" if EXPERT
 	help
diff --git a/arch/x86/Makefile b/arch/x86/Makefile
index 87234f971f12..6475f9073f91 100644
--- a/arch/x86/Makefile
+++ b/arch/x86/Makefile
@@ -63,6 +63,24 @@ REALMODE_CFLAGS += -Wno-gnu
 endif
 export REALMODE_CFLAGS
 
+ifeq ($(ARCH),l1om)
+tool-archpref = x86_64-l1om
+else ifeq ($(ARCH),k1om)
+tool-archpref = x86_64-k1om
+endif
+
+# override top level makefile
+ifneq ($(SUBARCH),$(ARCH))
+        ifeq ($(CROSS_COMPILE),)
+                ifneq ($(tool-archpref),)
+                        CROSS_COMPILE := $(call cc-cross-prefix, \
+                                $(tool-archpref)-linux-gnu- \
+                                $(tool-archpref)-linux- \
+                                $(tool-archpref)-unknown-linux-gnu-)
+                endif
+        endif
+endif
+
 # BITS is used as extension for files which are available in a 32 bit
 # and a 64 bit version to simplify shared Makefiles.
 # e.g.: obj-y += foo_$(BITS).o
@@ -134,8 +152,8 @@ ifeq ($(CONFIG_X86_32),y)
         percpu_seg := fs
 else
         BITS := 64
-        UTS_MACHINE := x86_64
-        CHECKFLAGS += -D__x86_64__
+        UTS_MACHINE := $(ARCH)
+        CHECKFLAGS += -D__x86_64__ -m64
 
         KBUILD_AFLAGS += -m64
         KBUILD_CFLAGS += -m64
@@ -239,7 +257,7 @@ KBUILD_RUSTFLAGS += $(PADDING_RUSTFLAGS)
 export PADDING_RUSTFLAGS
 endif
 
-KBUILD_LDFLAGS += -m elf_$(UTS_MACHINE)
+KBUILD_LDFLAGS += -m elf_$(UTS_MACHINE) --defsym=MIC_KERNEL_VERSION_20626=0
 
