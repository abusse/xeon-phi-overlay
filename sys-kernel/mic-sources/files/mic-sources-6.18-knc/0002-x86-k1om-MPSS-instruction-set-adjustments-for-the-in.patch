+/*
+ * verify_cpu returns 0 if the CPU supports long mode & SSE
+ * ML1OM & MK1OM support long mode, but not SSE
+ */
+#ifndef CONFIG_X86_EARLYMIC
 	/* Make sure cpu supports long mode. */
 	call	verify_cpu
 	testl	%eax, %eax
 	jnz	.Lno_longmode
+#endif
 
 /*
  * Compute the delta between where we were compiled to run at
diff --git a/arch/x86/include/asm/barrier.h b/arch/x86/include/asm/barrier.h
index db70832232d4..1e3ca5081109 100644
--- a/arch/x86/include/asm/barrier.h
+++ b/arch/x86/include/asm/barrier.h
@@ -18,6 +18,11 @@
 				       X86_FEATURE_XMM2) ::: "memory", "cc")
 #define wmb() asm volatile(ALTERNATIVE("lock addl $0,-4(%%esp)", "sfence", \
 				       X86_FEATURE_XMM2) ::: "memory", "cc")
+#elif defined(CONFIG_X86_EARLYMIC)
+/* k1om lacks usable mfence/lfence/sfence; serialize via a locked op. */
+#define mb() 	asm volatile("lock; addl $0,0(%%rsp)":::"memory")
+#define rmb()	asm volatile("lock; addl $0,0(%%rsp)":::"memory")
+#define wmb()	asm volatile("lock; addl $0,0(%%rsp)":::"memory")
 #else
 #define __mb()	asm volatile("mfence":::"memory")
 #define __rmb()	asm volatile("lfence":::"memory")
@@ -45,7 +50,12 @@
 	__mask; })
 
 /* Prevent speculative execution past this barrier. */
+#ifdef CONFIG_X86_EARLYMIC
+/* in-order core, and the assembler has no lfence */
+#define barrier_nospec() barrier()
+#else
 #define barrier_nospec() alternative("", "lfence", X86_FEATURE_LFENCE_RDTSC)
+#endif
 
 #define __dma_rmb()	barrier()
 #define __dma_wmb()	barrier()
