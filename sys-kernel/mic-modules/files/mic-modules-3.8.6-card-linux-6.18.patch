diff --git a/mic_proc_compat.h b/mic_proc_compat.h
new file mode 100644
index 0000000..c38f66a
--- /dev/null
+++ b/mic_proc_compat.h
@@ -0,0 +1,46 @@
+#ifndef _MIC_PROC_COMPAT_H
+#define _MIC_PROC_COMPAT_H
+/* v3.10 removed create_proc_entry/create_proc_read_entry (read_proc_t API).
+ * Minimal shim: wrap the old read_proc callback in a single_open seq_file. */
+#include <linux/proc_fs.h>
+#include <linux/seq_file.h>
+#include <linux/slab.h>
+#include <linux/version.h>
+#if LINUX_VERSION_CODE >= KERNEL_VERSION(5, 17, 0)
+#define PDE_DATA(inode) pde_data(inode)
+#endif
+typedef int (*compat_read_proc_t)(char *page, char **start, off_t off,
+				  int count, int *eof, void *data);
+struct compat_proc_priv { compat_read_proc_t rp; void *data; };
+static int compat_proc_show(struct seq_file *m, void *v)
+{
+	struct compat_proc_priv *p = m->private;
+	char *page = (char *)__get_free_page(GFP_KERNEL);
+	char *start = NULL; int eof = 0, len;
+	if (!page) return -ENOMEM;
+	len = p->rp(page, &start, 0, PAGE_SIZE - 1, &eof, p->data);
+	if (len > 0) seq_write(m, page, len);
+	free_page((unsigned long)page);
+	return 0;
+}
+static int compat_proc_open(struct inode *inode, struct file *file)
+{
+	return single_open(file, compat_proc_show, PDE_DATA(inode));
+}
+static const struct proc_ops compat_proc_fops = {
+	.proc_open = compat_proc_open,
+	.proc_read = seq_read, .proc_lseek = seq_lseek, .proc_release = single_release,
+};
+static inline struct proc_dir_entry *
+compat_create_proc_read_entry(const char *name, umode_t mode,
+			      struct proc_dir_entry *parent,
+			      compat_read_proc_t rp, void *data)
+{
+	struct compat_proc_priv *p = kmalloc(sizeof(*p), GFP_KERNEL);
+	if (!p) return NULL;
+	p->rp = rp; p->data = data;
+	return proc_create_data(name, mode, parent, &compat_proc_fops, p);
+}
+#define create_proc_read_entry(n, m, par, rp, d) \
+	compat_create_proc_read_entry(n, m, par, rp, d)
+#endif
