From c655361013f49d232e8d56a5ce504b72c18b67b9 Mon Sep 17 00:00:00 2001
From: Anselm Busse <anselm.busse@outlook.com>
Date: Wed, 30 Sep 2026 22:39:00 +0200
Subject: [PATCH 14/49] x86_64/fpu/587: sincos from the x87 sin and cos

Since 2.22 the dbl-64 sincos calls the dbl-64 sin/cos internals
(__mpsin, __branred, ...), which the 587 layer replaces with x87 code
and empty stubs, so libm fails to link.  Use the pre-2.22 implementation
on top of __sin and __cos, with the EDOM for infinite arguments of the
new one.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Signed-off-by: Anselm Busse <anselm.busse@outlook.com>
---
 sysdeps/x86_64/fpu/587/s_sincos.c | 49 +++++++++++++++++++++++++++++++
 1 file changed, 49 insertions(+)
 create mode 100644 sysdeps/x86_64/fpu/587/s_sincos.c

diff --git a/sysdeps/x86_64/fpu/587/s_sincos.c b/sysdeps/x86_64/fpu/587/s_sincos.c
new file mode 100644
index 0000000000..aa77bf7539
--- /dev/null
+++ b/sysdeps/x86_64/fpu/587/s_sincos.c
@@ -0,0 +1,49 @@
+/* Compute sine and cosine of argument, using the x87 sin and cos.
+   Copyright (C) 1997-2016 Free Software Foundation, Inc.
+   This file is part of the GNU C Library.
+
+   The GNU C Library is free software; you can redistribute it and/or
+   modify it under the terms of the GNU Lesser General Public
+   License as published by the Free Software Foundation; either
+   version 2.1 of the License, or (at your option) any later version.
+
+   The GNU C Library is distributed in the hope that it will be useful,
+   but WITHOUT ANY WARRANTY; without even the implied warranty of
+   MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the GNU
+   Lesser General Public License for more details.
+
+   You should have received a copy of the GNU Lesser General Public
+   License along with the GNU C Library; if not, see
+   <http://www.gnu.org/licenses/>.  */
+
+#include <errno.h>
+#include <math.h>
+
+#include <math_private.h>
+
+
+void
+__sincos (double x, double *sinx, double *cosx)
+{
+  int32_t ix;
+
+  GET_HIGH_WORD (ix, x);
+  ix &= 0x7fffffff;
+  if (ix >= 0x7ff00000)
+    {
+      /* sin(Inf or NaN) is NaN.  */
+      *sinx = *cosx = x - x;
+      if (isinf (x))
+	__set_errno (EDOM);
+    }
+  else
+    {
+      *sinx = __sin (x);
+      *cosx = __cos (x);
+    }
+}
+weak_alias (__sincos, sincos)
+#ifdef NO_LONG_DOUBLE
+strong_alias (__sincos, __sincosl)
+weak_alias (__sincos, sincosl)
+#endif
