From 81510bc1d1ae01a1bbbecacfa81779ca2b996682 Mon Sep 17 00:00:00 2001
From: Anselm Busse <anselm.busse@outlook.com>
Date: Wed, 30 Sep 2026 23:48:39 +0200
Subject: [PATCH 26/49] x86_64/k1om: keep the libpthread symbol versions in
 libc

The K1OM libpthread has the full x86_64 history (GLIBC_2.2.5 onwards)
while libc starts at GLIBC_2.14, and existing binaries need e.g.
pthread_create@GLIBC_2.2.5.  Since 2.34 these are compat symbols in
libc, which needs version nodes older than its own baseline for them.
Let !libc_pre_versions take the list of such versions (default GLIBC_2.0
GLIBC_2.1, as before) and list libpthread's for K1OM.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Signed-off-by: Anselm Busse <anselm.busse@outlook.com>
---
 scripts/versions.awk                         | 26 ++++++++++++++------
 sysdeps/unix/sysv/linux/x86_64/k1om/Versions |  1 +
 2 files changed, 20 insertions(+), 7 deletions(-)
 create mode 100644 sysdeps/unix/sysv/linux/x86_64/k1om/Versions

diff --git a/scripts/versions.awk b/scripts/versions.awk
index a68059e79a..8211f9fe6a 100644
--- a/scripts/versions.awk
+++ b/scripts/versions.awk
@@ -95,8 +95,14 @@ function ord(c) {
 # Some targets do not set the ABI baseline for libdl.  As a result,
 # symbols originally in libdl need to be moved under historic symbol
 # versions, without altering the baseline version for libc itself.
+# An optional list of versions replaces the default GLIBC_2.0 GLIBC_2.1.
 /^ *!libc_pre_versions/ {
     libc_pre_versions_active = 1;
+    if (NF > 1) {
+	libc_pre_versions_n = NF - 1;
+	for (i = 2; i <= NF; ++i)
+	    libc_pre_versions_list[i - 1] = $i;
+    }
 }
 
 function libc_pre_versions() {
@@ -104,13 +110,19 @@ function libc_pre_versions() {
     # if symbols are moved into libc.  The abilist files and the other
     # targets (with a real GLIBC_2.0 baseline) provide testing
     # coverage.
-    printf("\
-GLIBC_2.0 {\n\
-};\n\
-GLIBC_2.1 {\n\
-} GLIBC_2.0;\n\
-") > outfile;
-    return "GLIBC_2.1";
+    if (!libc_pre_versions_n) {
+	libc_pre_versions_n = 2;
+	libc_pre_versions_list[1] = "GLIBC_2.0";
+	libc_pre_versions_list[2] = "GLIBC_2.1";
+    }
+    for (i = 1; i <= libc_pre_versions_n; ++i) {
+	if (i == 1)
+	    printf("%s {\n};\n", libc_pre_versions_list[i]) > outfile;
+	else
+	    printf("%s {\n} %s;\n", libc_pre_versions_list[i],
+		   libc_pre_versions_list[i - 1]) > outfile;
+    }
+    return libc_pre_versions_list[libc_pre_versions_n];
 }
 
 function closeversion(name, oldname) {
diff --git a/sysdeps/unix/sysv/linux/x86_64/k1om/Versions b/sysdeps/unix/sysv/linux/x86_64/k1om/Versions
new file mode 100644
index 0000000000..5f1ba627a6
--- /dev/null
+++ b/sysdeps/unix/sysv/linux/x86_64/k1om/Versions
@@ -0,0 +1 @@
+!libc_pre_versions GLIBC_2.2.5 GLIBC_2.2.6 GLIBC_2.3.2 GLIBC_2.3.3 GLIBC_2.3.4 GLIBC_2.4 GLIBC_2.11 GLIBC_2.12
