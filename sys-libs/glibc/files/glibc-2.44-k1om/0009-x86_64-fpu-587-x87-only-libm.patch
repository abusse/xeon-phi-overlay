diff --git a/sysdeps/x86_64/fpu/587/e_acos.S b/sysdeps/x86_64/fpu/587/e_acos.S
new file mode 100644
index 0000000000..38fc99760d
--- /dev/null
+++ b/sysdeps/x86_64/fpu/587/e_acos.S
@@ -0,0 +1,26 @@
+/*
+ * Written by J.T. Conklin <jtc@netbsd.org>.
+ * Public domain.
+ */
+
+#include <machine/asm.h>
+
+RCSID("$NetBSD: e_acos.S,v 1.4 1995/05/08 23:44:37 jtc Exp $")
+
+/* acos = atan (sqrt(1 - x^2) / x) */
+ENTRY(__ieee754_acos)
+	LOAD_REG_K1
+	STORE_DOUBLE_REG (0, -8(%rsp))
+	fldl	-8(%rsp)		/* x */
+	fld	%st			/* x : x */
+	fmul	%st(0)			/* x^2 : x */
+	fld1				/* 1 : x^2 : x */
+	fsubp				/* 1 - x^2 : x */
+	fsqrt				/* sqrt (1 - x^2) : x */
+	fabs
+	fxch	%st(1)			/* x : sqrt (1 - x^2) */
+	fpatan				/* atan (sqrt(1 - x^2) / x) */
+	fstpl	-8(%rsp)
+	LOAD_DOUBLE_REG (-8(%rsp), 0)
+	ret
+END (__ieee754_acos)
diff --git a/sysdeps/x86_64/fpu/587/e_acosf.S b/sysdeps/x86_64/fpu/587/e_acosf.S
new file mode 100644
index 0000000000..557b9afbd2
--- /dev/null
+++ b/sysdeps/x86_64/fpu/587/e_acosf.S
@@ -0,0 +1,27 @@
+/*
+ * Written by J.T. Conklin <jtc@netbsd.org>.
+ * Public domain.
+ * Adapted for float type by Ulrich Drepper <drepper@cygnus.com>.
+ */
+
+#include <machine/asm.h>
+
+RCSID("$NetBSD: $")
+
+/* acos = atan (sqrt(1 - x^2) / x) */
+ENTRY(__ieee754_acosf)
+	LOAD_REG_K1
+	STORE_FLOAT_REG (0, -4(%rsp))
+	flds	-4(%rsp)		/* x */
+	fld	%st
+	fmul	%st(0)			/* x^2 */
+	fld1
+	fsubp				/* 1 - x^2 */
+	fsqrt				/* sqrt (1 - x^2) */
+	fabs
+	fxch	%st(1)
+	fpatan
+	fstps	-4(%rsp)
+	LOAD_FLOAT_REG (-4(%rsp), 0)
+	ret
+END (__ieee754_acosf)
