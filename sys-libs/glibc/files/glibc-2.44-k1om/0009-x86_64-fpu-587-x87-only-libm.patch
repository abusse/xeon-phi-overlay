+	fldl	VAL0(%rsp)
+	fmull	MO(two54)
+	movl	$-54, %ecx
+	fstpl	VAL0(%rsp)
+	fwait
+	movl	VAL1(%rsp), %eax
+	movl	%eax, %edx
+	andl	$0x7fffffff, %eax
+
+2:	shrl	$20, %eax
+	andl	$0x800fffff, %edx
+	subl	$1022, %eax
+	orl	$0x3fe00000, %edx
+	addl	%eax, %ecx
+	movl	%edx, VAL1(%rsp)
