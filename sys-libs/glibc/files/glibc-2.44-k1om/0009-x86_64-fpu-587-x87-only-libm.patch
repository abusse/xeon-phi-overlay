+	jnz	2b
+	fstp	%st(1)
+	fsin
+	fstpl	-8(%rsp)
+	LOAD_DOUBLE_REG (-8(%rsp), 0)
+	ret
+3:
+	call	__errno_location@PLT
+	movl	$EDOM, (%rax)
+	jmp	4b
+END (__sin)
