+	fstpt	-16(%rsp)
+	fstpt	-32(%rsp)
+	ftst
+	fnstsw
+	shll	$7, %eax
+	andl	$0x8000, %eax
+	orl	%eax, -24(%rsp)
+	fstp	%st(0)
+	ftst
+	fnstsw
+	shll	$7, %eax
+	andl	$0x8000, %eax
+	orl	%eax, -8(%rsp)
+	fstp	%st(0)
+	fldt	-16(%rsp)
+	fldt	-32(%rsp)
+	ret
+
+	/* The real part is +-Inf and the imaginary part is +-0.  So return
+	   +-Inf+-0i.  */
+	.align ALIGNARG(4)
+4:
+	fxch
+	shrl	$5, %edx
+	fstp    %st(0)
+	andl	$16, %edx
+#ifdef PIC
+	lea	huge_nan_null_null(%rip), %rcx
+	fldl	(%rcx, %rdx, 1)
+#else
+	fldl	huge_nan_null_null(, %rdx, 1)
+#endif
+	ret
+
+	/* The real part is +-Inf, the imaginary is also is not finite.  */
+	.align ALIGNARG(4)
+3:	fstp	%st(0)
+	fstp	%st(0)		/* <empty> */
