+	fldl	-8(%rsp)
+	fxam
+	fstsw	%ax
+	movb	$0x45, %dh
+	andb	%ah, %dh
+	cmpb	$0x05, %dh
+	je	3f
+4:	fsin
+	fnstsw	%ax
+	testl	$0x400,%eax
+	jnz	1f
+	fstpl	-8(%rsp)
