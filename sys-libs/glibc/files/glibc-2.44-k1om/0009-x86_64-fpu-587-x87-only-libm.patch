--- /dev/null
+++ b/sysdeps/x86_64/fpu/587/e_pow.S
@@ -0,0 +1,357 @@
+/* ix87 specific implementation of pow function.
+   Copyright (C) 2011
+   Free Software Foundation, Inc.
