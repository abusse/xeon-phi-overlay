+	.text
+ENTRY(__cexpl)
+	fldt	8(%rsp)			/* x */
+	fxam
+	fnstsw
+	fldt	24(%rsp)		/* y : x */
+	movb	%ah, %dh
+	andb	$0x45, %ah
+	cmpb	$0x05, %ah
+	je	1f			/* Jump if real part is +-Inf */
+	cmpb	$0x01, %ah
+	je	2f			/* Jump if real part is NaN */
+
+	fxam				/* y : x */
+	fnstsw
