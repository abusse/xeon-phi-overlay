From 3b96293ce6ca63808f9487cd9a2b2a06ca47b34f Mon Sep 17 00:00:00 2001
From: Anselm Busse <anselm.busse@outlook.com>
Date: Thu, 1 Oct 2026 10:49:32 +0200
Subject: [PATCH 46/49] x86/fpu: K1OM float128 round-to-odd tests the x87 flags

The narrowing float128 operations (f32mulf128 and friends) round to odd:
hold the environment with round-toward-zero, compute, and OR the inexact
flag into the result.  The K1OM libgcc raises soft-fp exceptions with
x87 operations, so testing only the MXCSR flags lost the sticky bit
(wrong results in all rounding modes).  Use the generic fesetround and
fetestexcept, which cover both units; the rounding mode soft-fp reads
stays in MXCSR.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Signed-off-by: Anselm Busse <anselm.busse@outlook.com>
---
 sysdeps/x86/fpu/fenv_private.h | 10 ++++++++--
 1 file changed, 8 insertions(+), 2 deletions(-)

diff --git a/sysdeps/x86/fpu/fenv_private.h b/sysdeps/x86/fpu/fenv_private.h
index e0704d5f42..f618afc4f3 100644
--- a/sysdeps/x86/fpu/fenv_private.h
+++ b/sysdeps/x86/fpu/fenv_private.h
@@ -300,8 +300,14 @@ libc_feresetround_387 (fenv_t *e)
    x86_64, so that must be set for float128 computations.  */
 # define SET_RESTORE_ROUNDF128(RM) \
   SET_RESTORE_ROUND_GENERIC (RM, libc_feholdsetround_sse, libc_feresetround_sse)
-# define libc_feholdexcept_setroundf128	libc_feholdexcept_setround_sse
-# define libc_feupdateenv_testf128	libc_feupdateenv_test_sse
+# ifdef __KNC__
+/* K1OM libgcc raises the soft-fp exceptions with x87 operations.  */
+#  define libc_feholdexcept_setroundf128	default_libc_feholdexcept_setround
+#  define libc_feupdateenv_testf128	default_libc_feupdateenv_test
+# else
+#  define libc_feholdexcept_setroundf128	libc_feholdexcept_setround_sse
+#  define libc_feupdateenv_testf128	libc_feupdateenv_test_sse
+# endif
 #else
 /* The 387 rounding mode is used by soft-fp for 32-bit, but whether
    387 or SSE exceptions are used depends on whether libgcc was built
