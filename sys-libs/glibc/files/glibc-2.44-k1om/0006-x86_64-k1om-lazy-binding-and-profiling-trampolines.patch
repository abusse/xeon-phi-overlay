 #else
 	movl	$TLSDESC_CALL_STATE_SAVE_MASK, %eax
@@ -134,7 +182,55 @@ _dl_tlsdesc_dynamic:
 	/* %rdi already points to the tlsinfo data structure.  */
 	call	HIDDEN_JUMPTARGET (__tls_get_addr)
 	# Get register content back.
-#ifdef USE_FXSAVE
