From 30af95cc8e0d2788c97120f8f6f9df6f1decb64c Mon Sep 17 00:00:00 2001
From: Anselm Busse <anselm.busse@outlook.com>
Date: Wed, 30 Sep 2026 22:31:19 +0200
Subject: [PATCH 06/49] x86_64/k1om: lazy-binding and profiling trampolines

Since 2.23 _dl_runtime_resolve saves the vector state with fxsave or
xsave, which K1OM does not have (fxsave does not cover zmm).  Add a
USE_VEC_SAVE variant of the template that saves zmm0-7 through the
STORE/LOAD_VEC_REG hooks in the same 512-byte area, build only
_dl_runtime_resolve_knc and _dl_runtime_profile_knc for K1OM and select
them in elf_machine_runtime_setup.  The profiler stores the argument
registers through the hooks as well, and the MPX bound register code
(including the bnd prefix) is left out.

[2.39: resolver selection moved to cpu-features.c and TLS descriptors
got fxsave/xsave variants: on K1OM those names are aliases of the K1OM
variants, and _dl_tlsdesc_dynamic_knc preserves the x87 state, zmm0-31
and k1-k7 as the TLS descriptor ABI requires.]

[2.26: cpu-features.h no longer needs ifunc-defines.h; the k1om copy of
ifunc-defines.sym is gone.]

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Signed-off-by: Anselm Busse <anselm.busse@outlook.com>
---
 sysdeps/x86_64/dl-machine.h          |  10 +++
 sysdeps/x86_64/dl-tlsdesc-dynamic.h  | 100 ++++++++++++++++++++++++++-
 sysdeps/x86_64/dl-tlsdesc.S          |  19 ++++-
 sysdeps/x86_64/dl-trampoline-state.h |   8 ++-
 sysdeps/x86_64/dl-trampoline.S       |  35 ++++++++++
 sysdeps/x86_64/dl-trampoline.h       |  38 +++++++---
 6 files changed, 195 insertions(+), 15 deletions(-)

diff --git a/sysdeps/x86_64/dl-machine.h b/sysdeps/x86_64/dl-machine.h
index a94cb1a8af..f9b66a5a20 100644
--- a/sysdeps/x86_64/dl-machine.h
+++ b/sysdeps/x86_64/dl-machine.h
@@ -74,6 +74,8 @@ elf_machine_runtime_setup (struct link_map *l, struct r_scope_elem *scope[],
   extern void _dl_runtime_profile_sse (ElfW(Word)) attribute_hidden;
   extern void _dl_runtime_profile_avx (ElfW(Word)) attribute_hidden;
   extern void _dl_runtime_profile_avx512 (ElfW(Word)) attribute_hidden;
+  extern void _dl_runtime_resolve_knc (ElfW(Word)) attribute_hidden;
+  extern void _dl_runtime_profile_knc (ElfW(Word)) attribute_hidden;
 
   if (l->l_info[DT_JMPREL] && lazy)
     {
@@ -103,12 +105,16 @@ elf_machine_runtime_setup (struct link_map *l, struct r_scope_elem *scope[],
       if (__glibc_unlikely (profile))
 	{
 	  const struct cpu_features* cpu_features = __get_cpu_features ();
+#ifdef __KNC__
+	  *(ElfW(Addr) *) (got + 2) = (ElfW(Addr)) &_dl_runtime_profile_knc;
+#else
 	  if (X86_ISA_CPU_FEATURE_USABLE_P (cpu_features, AVX512F))
 	    *(ElfW(Addr) *) (got + 2) = (ElfW(Addr)) &_dl_runtime_profile_avx512;
 	  else if (X86_ISA_CPU_FEATURE_USABLE_P (cpu_features, AVX))
 	    *(ElfW(Addr) *) (got + 2) = (ElfW(Addr)) &_dl_runtime_profile_avx;
 	  else
 	    *(ElfW(Addr) *) (got + 2) = (ElfW(Addr)) &_dl_runtime_profile_sse;
+#endif
 
 	  if (GLRO(dl_profile) != NULL
 	      && _dl_name_match_p (GLRO(dl_profile), l))
@@ -122,8 +128,12 @@ elf_machine_runtime_setup (struct link_map *l, struct r_scope_elem *scope[],
 	  /* This function will get called to fix up the GOT entry
 	     indicated by the offset on the stack, and then jump to
 	     the resolved address.  */
+#ifdef __KNC__
+	  *(ElfW(Addr) *) (got + 2) = (ElfW(Addr)) &_dl_runtime_resolve_knc;
+#else
 	  *(ElfW(Addr) *) (got + 2)
 	    = (ElfW(Addr)) GLRO(dl_x86_64_runtime_resolve);
+#endif
 	}
     }
 
