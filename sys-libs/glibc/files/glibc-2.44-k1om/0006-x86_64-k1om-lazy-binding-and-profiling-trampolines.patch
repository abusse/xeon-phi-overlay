+	.globl _dl_tlsdesc_dynamic_xsavec
+	.hidden _dl_tlsdesc_dynamic_xsavec
+	.set _dl_tlsdesc_dynamic_xsavec, _dl_tlsdesc_dynamic_knc
+#elif defined SHARED
 # if MINIMUM_X86_ISA_LEVEL < AVX_X86_ISA_LEVEL
 #  define USE_FXSAVE
 #  define STATE_SAVE_ALIGNMENT	16
diff --git a/sysdeps/x86_64/dl-trampoline-state.h b/sysdeps/x86_64/dl-trampoline-state.h
index 21cc9d5082..4653e3deea 100644
--- a/sysdeps/x86_64/dl-trampoline-state.h
+++ b/sysdeps/x86_64/dl-trampoline-state.h
@@ -28,8 +28,12 @@
 /* Local stack area before jumping to function address: RBX.  */
 # define LOCAL_STORAGE_AREA	8
 # define BASE			rbx
-# ifdef USE_FXSAVE
-/* Use fxsave to save XMM registers.  */
+# ifdef USE_KNC_SAVE
+/* K1OM: x87 state (fxsave), zmm0-31 and k1-k7.  */
+#  define REGISTER_SAVE_AREA	(512 + 32 * 64 + 64 + STATE_SAVE_OFFSET)
+# elif defined USE_FXSAVE || defined USE_VEC_SAVE
+/* Use fxsave to save XMM registers, or save the 8 argument vector
+   registers of K1OM (8 x 64 bytes).  */
 #  define REGISTER_SAVE_AREA	(512 + STATE_SAVE_OFFSET)
 #  if (REGISTER_SAVE_AREA % 16) != 0
 #   error REGISTER_SAVE_AREA must be multiple of 16
diff --git a/sysdeps/x86_64/dl-trampoline.S b/sysdeps/x86_64/dl-trampoline.S
index c3845717a0..d4a7ba6be5 100644
--- a/sysdeps/x86_64/dl-trampoline.S
+++ b/sysdeps/x86_64/dl-trampoline.S
@@ -33,6 +33,40 @@
 #define REGISTER_SAVE_R8	(REGISTER_SAVE_RDI + 8)
 #define REGISTER_SAVE_R9	(REGISTER_SAVE_R8 + 8)
 
+#ifdef __KNC__
+/* K1OM passes FP and vector arguments in zmm0-7; it has neither SSE,
+   AVX nor XSAVE.  */
+# define VEC_SIZE		64
+# define VMOVA			vmovaps
+# define VEC(i)			zmm##i
+# ifdef SHARED
+# define _dl_runtime_profile	_dl_runtime_profile_knc
+# include "dl-trampoline.h"
+# undef _dl_runtime_profile
+# endif
+# undef VEC
+# undef VMOVA
+# undef VEC_SIZE
+
+# define USE_VEC_SAVE
+# define STATE_SAVE_ALIGNMENT	64
+# define _dl_runtime_resolve	_dl_runtime_resolve_knc
+# include "dl-trampoline.h"
+# undef _dl_runtime_resolve
+# undef USE_VEC_SAVE
+# undef STATE_SAVE_ALIGNMENT
+/* Whatever cpu-features.c selects is the K1OM variant.  */
+	.globl _dl_runtime_resolve_fxsave
+	.hidden _dl_runtime_resolve_fxsave
+	.set _dl_runtime_resolve_fxsave, _dl_runtime_resolve_knc
+	.globl _dl_runtime_resolve_xsave
+	.hidden _dl_runtime_resolve_xsave
+	.set _dl_runtime_resolve_xsave, _dl_runtime_resolve_knc
+	.globl _dl_runtime_resolve_xsavec
+	.hidden _dl_runtime_resolve_xsavec
+	.set _dl_runtime_resolve_xsavec, _dl_runtime_resolve_knc
+#else
+
 #define RESTORE_AVX
 
 #ifdef SHARED
@@ -102,3 +136,4 @@
 #undef _dl_runtime_resolve
 #undef USE_XSAVEC
 #undef STATE_SAVE_ALIGNMENT
+#endif
