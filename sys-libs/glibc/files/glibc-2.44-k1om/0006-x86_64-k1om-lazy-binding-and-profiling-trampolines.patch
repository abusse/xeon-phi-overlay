+	STORE_VEC_REG (5, (LR_XMM_OFFSET + XMM_SIZE*5)(%rsp))
+	STORE_VEC_REG (6, (LR_XMM_OFFSET + XMM_SIZE*6)(%rsp))
+	STORE_VEC_REG (7, (LR_XMM_OFFSET + XMM_SIZE*7)(%rsp))
 
 # ifdef RESTORE_AVX
 	/* This is to support AVX audit modules.  */
