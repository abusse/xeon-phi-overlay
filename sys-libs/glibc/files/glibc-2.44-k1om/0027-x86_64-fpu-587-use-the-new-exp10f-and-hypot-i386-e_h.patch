From 37049ce789f1e3cf688ada81fda6f44076dce021 Mon Sep 17 00:00:00 2001
From: Anselm Busse <anselm.busse@outlook.com>
Date: Wed, 30 Sep 2026 23:50:06 +0200
Subject: [PATCH 27/49] x86_64/fpu/587: use the new exp10f and hypot, i386
 e_hypot.c

2.32 to 2.35 replaced exp10f, hypot and hypotf by implementations with
new symbol versions and no wrappers; the x87 versions only provide
__ieee754_* and break the libm link.  Do what i386 does: drop them, use
the generic exp10f and hypotf and i386 e_hypot.c, which relies on the
x87 excess precision like K1OM.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Signed-off-by: Anselm Busse <anselm.busse@outlook.com>
---
 sysdeps/x86_64/fpu/587/e_exp10f.S | 51 -----------------------
 sysdeps/x86_64/fpu/587/e_hypot.S  | 67 -------------------------------
 sysdeps/x86_64/fpu/587/e_hypot.c  |  1 +
 sysdeps/x86_64/fpu/587/e_hypotf.S | 67 -------------------------------
 4 files changed, 1 insertion(+), 185 deletions(-)
 delete mode 100644 sysdeps/x86_64/fpu/587/e_exp10f.S
 delete mode 100644 sysdeps/x86_64/fpu/587/e_hypot.S
 create mode 100644 sysdeps/x86_64/fpu/587/e_hypot.c
 delete mode 100644 sysdeps/x86_64/fpu/587/e_hypotf.S

diff --git a/sysdeps/x86_64/fpu/587/e_exp10f.S b/sysdeps/x86_64/fpu/587/e_exp10f.S
deleted file mode 100644
index 3b796331c2..0000000000
--- a/sysdeps/x86_64/fpu/587/e_exp10f.S
+++ /dev/null
@@ -1,51 +0,0 @@
-/*
- * Written by Ulrich Drepper.
- */
-
-#include <machine/asm.h>
-
-	.section .rodata
-	.p2align 2
-zero:	.float 0.0
-
-	.text
-/* e^x = 2^(x * log2(10)) */
-ENTRY(__ieee754_exp10f)
-	LOAD_REG_K1
-	STORE_FLOAT_REG (0, -4(%rsp))
-	flds	-4(%rsp)
-/* I added the following ugly construct because exp(+-Inf) resulted
-   in NaN.  The ugliness results from the bright minds at Intel.
-   For the i686 the code can be written better.
-   -- drepper@cygnus.com.  */
-	fxam				/* Is NaN or +-Inf?  */
-	fstsw	%ax
-	movb	$0x45, %dh
-	andb	%ah, %dh
-	cmpb	$0x05, %dh
-	je	1f			/* Is +-Inf, jump.  */
-	fldl2t
-	fmulp				/* x * log2(10) */
-	fld	%st
-	frndint				/* int(x * log2(10)) */
-	fsubr	%st,%st(1)		/* fract(x * log2(10)) */
-	fxch
-	f2xm1				/* 2^(fract(x * log2(10))) - 1 */
-	fld1
-	faddp				/* 2^(fract(x * log2(10))) */
-	fscale				/* e^x */
-	fstp	%st(1)
-	fstps	-4(%rsp)
-	LOAD_FLOAT_REG (-4(%rsp), 0)
-	ret
-
-1:	testl	$0x200, %eax		/* Test sign.  */
-	jz	2f			/* If positive, jump.  */
-	fstp	%st
-	LOAD_FLOAT_REG (zero(%rip), 0)	/* Set result to 0.  */
-	ret
-2:
-	fstps	-4(%rsp)
-	LOAD_FLOAT_REG (-4(%rsp), 0)
-	ret
-END (__ieee754_exp10f)
