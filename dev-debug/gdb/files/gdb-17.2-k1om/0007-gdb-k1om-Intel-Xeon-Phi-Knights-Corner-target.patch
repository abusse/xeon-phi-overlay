+      set_gdbarch_stab_reg_to_regnum (gdbarch, k1om_dwarf_reg_to_regnum);
+      set_gdbarch_core_read_x86_xsave_layout (gdbarch, nullptr);
+      set_gdbarch_iterate_over_regset_sections
