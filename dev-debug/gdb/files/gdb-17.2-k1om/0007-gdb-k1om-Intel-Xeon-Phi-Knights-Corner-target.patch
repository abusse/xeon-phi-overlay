+  tdesc_add_flag (type_with_fields, 15, "FZ");
+  tdesc_add_flag (type_with_fields, 21, "DUE");
+
+  regnum = 40;
+  tdesc_create_reg (feature, "k0", regnum++, 1, NULL, 16, "uint16");
+  tdesc_create_reg (feature, "k1", regnum++, 1, NULL, 16, "uint16");
