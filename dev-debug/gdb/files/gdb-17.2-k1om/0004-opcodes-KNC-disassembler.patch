+  ins->codep++;
+  ins->vex.eh = *ins->codep & 0x80;
+  ins->vex.swizzle = (*ins->codep & 0x70) >> 4;
+  ins->vex.mask_register_specifier = *ins->codep & 0x7;
+  ins->vex.v = *ins->codep & 0x8;
