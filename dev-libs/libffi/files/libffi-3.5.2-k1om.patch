KNC (k1om) has no SSE registers; its psABI passes float/double arguments
and returns in the low lane of %zmm0-7 instead of %xmm0-7.

--- a/src/x86/unix64.S
+++ b/src/x86/unix64.S
@@ -28,6 +28,15 @@
 
 #ifdef __x86_64__
 #define LIBFFI_ASM	
+
+#ifdef __k1om__
+/* KNC has no SSE registers: float/double arguments and returns live in the
+   low lane of %zmm0-7.  Stores go through a masked packstore; K1OM_ZLO moves
+   the low 64 bits of a zmm register into a GPR via an 8-byte red-zone slot,
+   since the final destination is not always 8-byte aligned.  */
+# define K1OM_K1		movl $1, %r11d; kmov %r11d, %k1
+# define K1OM_ZLO(z, r)	K1OM_K1; vpackstorelpd z, -48(%rsp){%k1}; movq -48(%rsp), r
+#endif
 #include <fficonfig.h>
 #include <ffi.h>
 #include "internal64.h"
