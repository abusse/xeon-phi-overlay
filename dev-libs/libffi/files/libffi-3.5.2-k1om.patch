 	ret
+#endif
 E(L(store_table), UNIX64_RET_XMM64)
 	_CET_ENDBR
+#ifdef __k1om__
+	jmp	L(k1om_st_xmm64)
+#else
 	movq	%xmm0, (%rdi)
