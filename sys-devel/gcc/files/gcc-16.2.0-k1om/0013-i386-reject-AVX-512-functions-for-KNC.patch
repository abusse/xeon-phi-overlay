From bd1057af914b13ca6cee797fd6b15f2157a22e24 Mon Sep 17 00:00:00 2001
From: Anselm Busse <anselm.busse@outlook.com>
Date: Wed, 30 Sep 2026 11:17:31 +0200
Subject: [PATCH 13/22] i386: reject AVX-512 functions for KNC

A function built for AVX-512 on top of -march=knc (target attribute or
pragma, e.g. libgfortran's matmul_r4_avx512f) sent LRA into an endless
split-and-reassign loop.  KNC cannot run AVX-512 code and the k1om
assembler rejects nearly all of it, so report an error when such a
function is expanded; that also keeps it out of register allocation.
Functions that are only declared under such a pragma, as in
<immintrin.h>, are not affected.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Signed-off-by: Anselm Busse <anselm.busse@outlook.com>
---
 gcc/config/i386/i386.cc | 14 ++++++++++++++
 1 file changed, 14 insertions(+)

diff --git a/gcc/config/i386/i386.cc b/gcc/config/i386/i386.cc
index 4905d9c1c54..32fb4558f6a 100644
--- a/gcc/config/i386/i386.cc
+++ b/gcc/config/i386/i386.cc
@@ -28319,6 +28319,18 @@ static const scoped_attribute_specs *const ix86_attribute_table[] =
   &ix86_gnu_attribute_table
 };
 
+/* Implement TARGET_EXPAND_TO_RTL_HOOK.  KNC cannot run AVX-512 code, and
+   register allocation does not terminate on it for KNC, so reject a
+   function compiled for both before it gets there.  */
+
+static void
+ix86_expand_to_rtl_hook (void)
+{
+  if (TARGET_KNC && TARGET_AVX512F)
+    error_at (DECL_SOURCE_LOCATION (current_function_decl),
+	      "AVX-512 is not supported for KNC");
+}
+
 /* Initialize the GCC target structure.  */
 #undef TARGET_RETURN_IN_MEMORY
 #define TARGET_RETURN_IN_MEMORY ix86_return_in_memory
@@ -28712,6 +28724,8 @@ ix86_libgcc_floating_mode_supported_p
 
 #undef TARGET_SET_CURRENT_FUNCTION
 #define TARGET_SET_CURRENT_FUNCTION ix86_set_current_function
+#undef TARGET_EXPAND_TO_RTL_HOOK
+#define TARGET_EXPAND_TO_RTL_HOOK ix86_expand_to_rtl_hook
 
 #undef TARGET_OPTION_VALID_ATTRIBUTE_P
 #define TARGET_OPTION_VALID_ATTRIBUTE_P ix86_valid_target_attribute_p
