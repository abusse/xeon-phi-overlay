@@ -688,7 +688,7 @@ i[34567]86-*-*)
 	;;
 x86_64-*-darwin*)
 	;;
-x86_64-*-*)
+x86_64-*-* | k1om-*-*)
         # Pick a default with_abi and with_multilib_list for m32
         # restricted toolchains
         case ${target} in
@@ -2120,11 +2120,11 @@ i[34567]86-*-linux* | i[34567]86-*-kfreebsd*-gnu | i[34567]86-*-gnu* | i[34567]8
 		;;
 	esac
 	;;
-x86_64-*-linux* | x86_64-*-kfreebsd*-gnu | x86_64-*-gnu*)
+x86_64-*-linux* | x86_64-*-kfreebsd*-gnu | x86_64-*-gnu* | k1om-*-linux*)
 	tm_file="${tm_file} i386/unix.h i386/att.h elfos.h gnu-user.h glibc-stdint.h \
 		 i386/x86-64.h i386/gnu-user-common.h i386/gnu-user64.h"
 	case ${target} in
-	x86_64-*-linux*)
+	x86_64-*-linux* | k1om-*-linux*)
 		tm_file="${tm_file} linux.h linux-android.h i386/linux-common.h i386/linux64.h"
 		extra_options="${extra_options} linux-android.opt"
 	  	;;
@@ -2135,6 +2135,11 @@ x86_64-*-linux* | x86_64-*-kfreebsd*-gnu | x86_64-*-gnu*)
 		tm_file="${tm_file} gnu.h i386/gnu64.h"
 		;;
 	esac
+	case ${target} in
+	x86_64-k1om-linux* | k1om-*-linux*)
+	  tm_file="${tm_file} i386/linuxk1om.h"
+	  ;;
+	esac;
 	tmake_file="${tmake_file} i386/t-linux64"
 	x86_multilibs="${with_multilib_list}"
 	if test "$x86_multilibs" = "default"; then
@@ -3716,10 +3721,10 @@ m32c-*-elf*)
 esac
 
 case ${target} in
-i[34567]86-*-linux* | x86_64-*-linux*)
+i[34567]86-*-linux* | x86_64-*-linux* | k1om-*-linux*)
 	tmake_file="${tmake_file} i386/t-pmm_malloc i386/t-i386"
 	;;
-i[34567]86-*-* | x86_64-*-*)
+i[34567]86-*-* | x86_64-*-* | k1om-*-*)
 	tmake_file="${tmake_file} i386/t-gmm_malloc i386/t-i386"
 	;;
 powerpc*-*-* | rs6000-*-*)
@@ -4030,6 +4035,10 @@ case ${target} in
 	;;
     esac
     ;;
+  x86_64-k1om-linux* | k1om-*-linux*)
+    arch=knc
+    cpu=knc
+    ;;
   x86_64-*-*)
     case ${target_noncanonical} in
       znver1-*)
@@ -4155,6 +4164,9 @@ if test x$with_cpu = x ; then
     i[34567]86-*-elfiamcu)
       with_cpu=lakemont
       ;;
+    k1om-*-*)
+      with_cpu=knc
+      ;;
     i[34567]86-*-*|x86_64-*-*)
       with_cpu=$cpu
       ;;
@@ -4255,6 +4267,9 @@ if test x$with_arch = x ; then
 	with_arch=pentium4
       fi
       ;;
+    k1om-*-*)
+      with_arch=knc
+      ;;
     x86_64-*-*)
       with_arch=$arch
       ;;
@@ -4275,7 +4290,7 @@ if test x$with_arch = x ; then
       # Default arch is set via TARGET_SUBTARGET32_ISA_DEFAULT
       # and TARGET_SUBTARGET64_ISA_DEFAULT in config/i386/darwin.h.
       ;;
-    i[34567]86-*-*|x86_64-*-*)
+    i[34567]86-*-*|x86_64-*-*|k1om-*-*)
       if test x$with_arch_32 != x || test x$with_arch_64 != x; then
 	if test x$with_arch_32 = x; then
 	  with_arch_32=$with_arch
@@ -4325,7 +4340,7 @@ fi
 # Support --with-fpmath.
 if test x$with_fpmath != x; then
   case ${target} in
-    i[34567]86-*-* | x86_64-*-*)
+    i[34567]86-*-* | x86_64-*-* | k1om-*-*)
       case ${with_fpmath} in
       avx)
 	tm_file="${tm_file} i386/avxmath.h"
@@ -4784,14 +4799,14 @@ case "${target}" in
 		esac
 		;;
 
-	i[34567]86-*-* | x86_64-*-*)
+	i[34567]86-*-* | x86_64-*-* | k1om-*-*)
 		supported_defaults="abi arch arch_32 arch_64 cpu cpu_32 cpu_64 tune tune_32 tune_64 tls"
 		for which in arch arch_32 arch_64 cpu cpu_32 cpu_64 tune tune_32 tune_64; do
 			eval "val=\$with_$which"
 			case " $x86_archs " in
 			*" ${val} "*)
 				case "${target}" in
-				  x86_64-*-*)
+				  x86_64-*-* | k1om-*-*)
 				      case "x$which" in
 					*_32)
 						;;
@@ -6120,7 +6135,7 @@ case ${target} in
 
 	i[34567]86-*-darwin* | x86_64-*-darwin*)
 		;;
-	i[34567]86-*-linux* | x86_64-*-linux*)
+	i[34567]86-*-linux* | x86_64-*-linux* | k1om-*-linux*)
 		extra_objs="${extra_objs} gnu-property.o"
 		tmake_file="$tmake_file i386/t-linux i386/t-gnu-property"
 		;;
@@ -6350,7 +6365,7 @@ then
 fi
 
 case ${target} in
-i[34567]86-*-* | x86_64-*-*)
+i[34567]86-*-* | x86_64-*-* | k1om-*-*)
 	if test x$enable_as_accelerator = xyes; then
 		extra_programs="mkoffload\$(exeext)"
 	fi
diff --git a/gcc/config/i386/linuxk1om.h b/gcc/config/i386/linuxk1om.h
new file mode 100644
index 00000000000..f69b7422f2e
--- /dev/null
+++ b/gcc/config/i386/linuxk1om.h
@@ -0,0 +1,47 @@
+/* Definitions for Intel K1OM running Linux-based GNU systems with ELF
+   format.
