 /* Enable MMX, SSE and SSE2 by default.  */
 #define TARGET_SUBTARGET64_ISA_DEFAULT \
   (OPTION_MASK_ISA_MMX | OPTION_MASK_ISA_SSE | OPTION_MASK_ISA_SSE2)
+#define TARGET_SUBTARGET_ISA2_DEFAULT 0
 
