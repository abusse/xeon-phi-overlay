 gcc/config/i386/i386.opt              |   4 +
 gcc/config/i386/sse.md                |   4 +-
 gcc/config/i386/sync.md               |   1 +
 gcc/config/i386/x86-tune-costs.h      | 129 ++++++++++++++++++++++++++
 12 files changed, 211 insertions(+), 10 deletions(-)

diff --git a/gcc/common/config/i386/i386-common.cc b/gcc/common/config/i386/i386-common.cc
index effc570aca1..9fbcb5c2779 100644
--- a/gcc/common/config/i386/i386-common.cc
+++ b/gcc/common/config/i386/i386-common.cc
@@ -2490,6 +2490,8 @@ const pta processor_alias_table[] =
     PTA_C86_4G_M8,
     M_CPU_SUBTYPE (HYGONFAM18H_C86_4G_M8), P_PROC_AVX512F},
 
+  {"knc", PROCESSOR_PENTIUM, CPU_GENERIC,
+    PTA_64BIT | PTA_NO_SAHF, 0, P_NONE},
   {"generic", PROCESSOR_GENERIC, CPU_GENERIC,
     PTA_64BIT
       | PTA_HLE /* flags are only used for -march switch.  */,
diff --git a/gcc/config.gcc b/gcc/config.gcc
index 743421768ea..bafae2dc883 100644
--- a/gcc/config.gcc
+++ b/gcc/config.gcc
@@ -768,7 +768,7 @@ sapphirerapids alderlake rocketlake eden-x2 nano nano-1000 nano-2000 nano-3000 \
 nano-x2 eden-x4 nano-x4 lujiazui yongfeng shijidadao x86-64 x86-64-v2 \
 x86-64-v3 x86-64-v4 sierraforest graniterapids graniterapids-d grandridge \
 arrowlake arrowlake-s clearwaterforest pantherlake diamondrapids novalake \
-c86-4g-m4 c86-4g-m6 c86-4g-m7 c86-4g-m8 native"
+c86-4g-m4 c86-4g-m6 c86-4g-m7 c86-4g-m8 native knc"
 
 # Additional x86 processors supported by --with-cpu=.  Each processor
 # MUST be separated by exactly one space.
diff --git a/gcc/config/i386/i386-builtins.cc b/gcc/config/i386/i386-builtins.cc
index 6837efd8da5..1bae72d15de 100644
--- a/gcc/config/i386/i386-builtins.cc
+++ b/gcc/config/i386/i386-builtins.cc
@@ -649,10 +649,12 @@ ix86_init_mmx_sse_builtins (void)
 		 IX86_BUILTIN__BDESC_COMI_FIRST,
 		 ARRAY_SIZE (bdesc_comi) - 1);
 
-  /* SSE */
-  def_builtin (OPTION_MASK_ISA_SSE, 0,  "__builtin_ia32_ldmxcsr",
+  /* SSE or KNC */
+  def_builtin (TARGET_KNC ? 0 : OPTION_MASK_ISA_SSE, 0,
+	       "__builtin_ia32_ldmxcsr",
 	       VOID_FTYPE_UNSIGNED, IX86_BUILTIN_LDMXCSR);
-  def_builtin_pure (OPTION_MASK_ISA_SSE, 0, "__builtin_ia32_stmxcsr",
+  def_builtin_pure (TARGET_KNC ? 0 : OPTION_MASK_ISA_SSE, 0,
+		    "__builtin_ia32_stmxcsr",
 		    UNSIGNED_FTYPE_VOID, IX86_BUILTIN_STMXCSR);
 
   /* SSE or 3DNow!A */
diff --git a/gcc/config/i386/i386-c.cc b/gcc/config/i386/i386-c.cc
index a2749ae6b14..9db439b38df 100644
--- a/gcc/config/i386/i386-c.cc
+++ b/gcc/config/i386/i386-c.cc
@@ -63,6 +63,8 @@ ix86_target_macros_internal (HOST_WIDE_INT isa_flag,
     case PROCESSOR_LAKEMONT:
       /* Intel MCU is based on Intel Pentium CPU.  */
     case PROCESSOR_PENTIUM:
+      if (TARGET_64BIT)
+        break;
       def_or_undef (parse_in, "__i586");
       def_or_undef (parse_in, "__i586__");
       def_or_undef (parse_in, "__pentium");
@@ -337,6 +339,8 @@ ix86_target_macros_internal (HOST_WIDE_INT isa_flag,
       def_or_undef (parse_in, "__tune_i486__");
       break;
     case PROCESSOR_PENTIUM:
+      if (TARGET_64BIT)
+        break;
       def_or_undef (parse_in, "__tune_i586__");
       def_or_undef (parse_in, "__tune_pentium__");
       if (last_tune_char == 'x')
@@ -636,6 +640,11 @@ ix86_target_macros_internal (HOST_WIDE_INT isa_flag,
     def_or_undef (parse_in, "__FMA__");
   if (isa_flag & OPTION_MASK_ISA_RTM)
     def_or_undef (parse_in, "__RTM__");
+  if (isa_flag2 & OPTION_MASK_ISA2_KNC) {
+    def_or_undef (parse_in, "__KNC__");
+    def_or_undef (parse_in, "__k1om"),
+    def_or_undef (parse_in, "__k1om__");
+  }
   if (isa_flag & OPTION_MASK_ISA_SSE4A)
     def_or_undef (parse_in, "__SSE4A__");
   if (isa_flag & OPTION_MASK_ISA_FMA4)
diff --git a/gcc/config/i386/i386-expand.cc b/gcc/config/i386/i386-expand.cc
index be6aed2bd21..4c91c74e099 100644
--- a/gcc/config/i386/i386-expand.cc
+++ b/gcc/config/i386/i386-expand.cc
@@ -2810,7 +2810,7 @@ ix86_prepare_fp_compare_args (enum rtx_code code, rtx *pop0, rtx *pop1)
   bool unordered_compare = ix86_unordered_fp_compare (code);
   rtx op0 = *pop0, op1 = *pop1;
   machine_mode op_mode = GET_MODE (op0);
-  bool is_sse = SSE_FLOAT_MODE_SSEMATH_OR_HFBF_P (op_mode);
+  bool is_sse = !TARGET_KNC && SSE_FLOAT_MODE_SSEMATH_OR_HFBF_P (op_mode);
 
   if (op_mode == BFmode && (!TARGET_AVX10_2 || flag_trapping_math))
     {
@@ -4688,6 +4688,9 @@ ix86_expand_fp_movcc (rtx operands[])
   rtx op0 = XEXP (operands[1], 0);
   rtx op1 = XEXP (operands[1], 1);
 
+  if (TARGET_KNC)
+    return false;
+
   if (GET_MODE (op0) == BFmode
       && !ix86_fp_comparison_operator (operands[1], VOIDmode))
     return false;
diff --git a/gcc/config/i386/i386-options.cc b/gcc/config/i386/i386-options.cc
index dc7f8bf003f..6b56bca9d0a 100644
--- a/gcc/config/i386/i386-options.cc
+++ b/gcc/config/i386/i386-options.cc
@@ -1109,6 +1109,7 @@ ix86_valid_target_attribute_inner_p (tree fndecl, tree args, char *p_strings[],
     IX86_ATTR_ISA ("ptwrite",   OPT_mptwrite),
     IX86_ATTR_ISA ("kl", OPT_mkl),
     IX86_ATTR_ISA ("widekl",	OPT_mwidekl),
+    IX86_ATTR_ISA ("knc",	OPT_mknc),
     IX86_ATTR_ISA ("avx512bf16",   OPT_mavx512bf16),
     IX86_ATTR_ISA ("enqcmd", OPT_menqcmd),
     IX86_ATTR_ISA ("serialize", OPT_mserialize),
@@ -2040,6 +2041,8 @@ ix86_option_override_internal (bool main_args_p,
       { "vec-sqrt",  RECIP_MASK_VEC_SQRT },
     };
 
+  long long  mic_isa_bit;
+
   /* Turn off both OPTION_MASK_ABI_64 and OPTION_MASK_ABI_X32 if
      TARGET_64BIT_DEFAULT is true and TARGET_64BIT is false.  */
   if (TARGET_64BIT_DEFAULT && !TARGET_64BIT_P (opts->x_ix86_isa_flags))
@@ -2407,6 +2410,11 @@ ix86_option_override_internal (bool main_args_p,
 	    else
 	      opts->x_target_flags |= MASK_80387;
 	  }
+	/* The PTA word is full in GCC 7; recognise the knc entry by name.  */
+	if (!strcmp (processor_alias_table[i].name, "knc")
+	    && !(ix86_isa_flags2_explicit & OPTION_MASK_ISA2_KNC))
+	  ix86_isa_flags2 |= OPTION_MASK_ISA2_KNC;
+
 	break;
       }
 
@@ -2583,6 +2591,9 @@ ix86_option_override_internal (bool main_args_p,
       if (!ix86_arch_specified)
 	opts->x_ix86_isa_flags
 	  |= TARGET_SUBTARGET64_ISA_DEFAULT & ~opts->x_ix86_isa_flags_explicit;
+      if (!ix86_arch_specified)
+	opts->x_ix86_isa_flags2
+	  |= TARGET_SUBTARGET_ISA2_DEFAULT & ~opts->x_ix86_isa_flags2_explicit;
 
       if (!TARGET_128BIT_LONG_DOUBLE_P (opts->x_target_flags))
 	error ("%<-m96bit-long-double%> is not compatible with this target");
@@ -2816,6 +2827,45 @@ ix86_option_override_internal (bool main_args_p,
       opts->x_target_flags |= MASK_ACCUMULATE_OUTGOING_ARGS;
     }
 
+   if (TARGET_KNC)
+    {
+      /* Always use KNC instruction costs.  */
+      ix86_cost = &knc_cost;
+      mic_isa_bit = OPTION_MASK_ISA2_KNC;
+    }
+  else
+    mic_isa_bit = 0;
+
+  if (mic_isa_bit)
+    {
+      /* Disable CMOVE.  */
+      TARGET_CMOV = 0;
+
+      /* Don't allow move from and to vector unit.  */
+      TARGET_INTER_UNIT_MOVES_FROM_VEC = 0;
+      TARGET_INTER_UNIT_MOVES_TO_VEC = 0;
+
+      if (TARGET_64BIT)
+	{
+	  /* Enable extended REX SSE registers.  */
+	  /* TARGET_EXT_REX_SSE_REGS = 1; */
+
+	  /* Enable mask registers.  */
+	  /* TARGET_MASK_REGS = 1; */
+	}
+      else
+	{
+	  /* Turn off KNC ISA in 32bit.  */
+	  ix86_isa_flags2 &= ~mic_isa_bit;
+	}
+    }
+
+  /* For sane SSE instruction set generation we need fcomi instruction.
+     It is safe to enable all CMOVE instructions.  Also, RDRAND intrinsic
+     expands to a sequence that includes conditional move. */
+  if (TARGET_SSE || TARGET_RDRND)
+    TARGET_CMOV = 1;
+
   /* Figure out what ASM_GENERATE_INTERNAL_LABEL builds as a prefix.  */
   {
     char *p;
