From ae4be4fcff9ee9ed7e36407e1ffdf56677a7c6ff Mon Sep 17 00:00:00 2001
From: Anselm Busse <anselm.busse@outlook.com>
Date: Wed, 30 Sep 2026 14:19:50 +0200
Subject: [PATCH 14/22] lra: keep address reloads of a store turned into a
 secondary reload

With "lra: consult secondary_reload for register to memory moves",
check_and_process_move() also handles register-to-memory moves: for KNC
it replaces a store from a vector register by the knc_reload_out
sequence and deletes the insn.  curr_insn_transform() calls it after
process_address(), so address reloads made for the store were dropped
with the insn and the address register was used uninitialised
(libquadmath's __quadmath_rem_pio2q stored through a never-set %r15, and
sinq crashed).  Emit them before calling check_and_process_move().

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Signed-off-by: Anselm Busse <anselm.busse@outlook.com>
---
 gcc/lra-constraints.cc | 17 ++++++++++++++---
 1 file changed, 14 insertions(+), 3 deletions(-)

diff --git a/gcc/lra-constraints.cc b/gcc/lra-constraints.cc
index 5c6bd35b5e3..7890e891f0b 100644
--- a/gcc/lra-constraints.cc
+++ b/gcc/lra-constraints.cc
@@ -4522,9 +4522,20 @@ curr_insn_transform (bool check_only_p)
        we chose previously may no longer be valid.  */
     lra_set_used_insn_alternative (curr_insn, LRA_UNKNOWN_ALT);
 
-  if (! check_only_p && curr_insn_set != NULL_RTX
-      && check_and_process_move (&change_p, &sec_mem_p))
-    return change_p;
+  if (! check_only_p && curr_insn_set != NULL_RTX)
+    {
+      /* check_and_process_move can replace the insn by a secondary
+	 reload sequence and delete it, dropping the address reloads
+	 made above: emit them first.  */
+      if (before != NULL)
+	{
+	  lra_process_new_insns (curr_insn, before, NULL,
+				 "Inserting address reload before");
+	  before = NULL;
+	}
+      if (check_and_process_move (&change_p, &sec_mem_p))
+	return change_p;
+    }
 
  try_swapped:
 
