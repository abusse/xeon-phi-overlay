From 67ba374ccc82ef2c9dc8b0514330bd8bf20c4d83 Mon Sep 17 00:00:00 2001
From: Anselm Busse <anselm.busse@outlook.com>
Date: Wed, 30 Sep 2026 10:50:29 +0200
Subject: [PATCH 6/7] opcodes: print (bad) for KNC mask register numbers above
 7

VEX.vvvv, ModRM.reg/rm with REX, and the MVEX V' bit can name a mask
register beyond k7; OP_VEX, OP_G and OP_E_register indexed the 8-entry
names_mask[] with it and printed whatever followed the array, or
crashed.  Print (bad), as later AVX-512 support does.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Signed-off-by: Anselm Busse <anselm.busse@outlook.com>
---
 opcodes/i386-dis.c | 10 ++++++++++
 1 file changed, 10 insertions(+)

diff --git a/opcodes/i386-dis.c b/opcodes/i386-dis.c
index d5a78e3c3f9..f783b6b6d4b 100644
--- a/opcodes/i386-dis.c
+++ b/opcodes/i386-dis.c
@@ -16028,6 +16028,11 @@ OP_MVEX_VEX (instr_info *ins, int bytemode, int sizeflag ATTRIBUTE_UNUSED)
 	    names = att_names32;
 	  break;
 	case mask_mode:
+	  if (reg > 0x7)
+	    {
+	      oappend (ins, "(bad)");
+	      return true;
+	    }
 	  names = att_names_mask;
 	  break;
 	default:
@@ -16055,6 +16060,11 @@ OP_MVEX_VEX (instr_info *ins, int bytemode, int sizeflag ATTRIBUTE_UNUSED)
 	switch (bytemode)
 	  {
 	  case mask_zmm_mode:
+	    if (reg > 0x7)
+	      {
+		oappend (ins, "(bad)");
+		return true;
+	      }
 	    names = att_names_mask;
 	    break;
 	  case x_mode:
