+static INLINE int
+fits_in_mvex_disp8 (offsetT num)
+{
+  int shift = i.vec.shift;
+  unsigned int mask;
+  
+  if (shift == -1)
+    abort ();
+
+  mask = (1 << shift) - 1;
+
+  /* Return 0 if NUM isn't properly aligned.  */
+  if ((num & mask))
+    return 0;
+
+  /* Check if NUM will fit in 8bit after shift.  */
+  return fits_in_signed_byte (num >> shift);
+}
